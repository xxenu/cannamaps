# Raw scrape output — the crawler's working directory, one folder per town.
# Everything the app actually serves has already been copied into
# public/data/, so this is just a large local cache. Regenerate with the
# scripts in tools/.
coffeeshopmenus/

# public/data/menus/ and public/data/logos/ are committed: coffeeshopmenus.org
# permits reuse of the images, so the deployed site can serve them.

.DS_Store
node_modules/

# Timestamped backups the data scripts leave behind. They live under public/,
# so without this they would be served and cached by the service worker.
public/data/*.bak-*

# Compiled OCR helper — build it locally with:
#   swiftc -O tools/ocr/ocr.swift -o tools/ocr/ocr
tools/ocr/ocr

# Saved copy of the coffeeshopmenus.org index page, the input to step 1.
# Same reasoning as coffeeshopmenus/ above: local working material, not ours
# to redistribute. Fetch it with:
#   curl -A "Mozilla/5.0" https://www.coffeeshopmenus.org/ -o tools/scrape/ams_index.html
tools/scrape/ams_index.html
